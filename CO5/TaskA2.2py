station = "  adyar  "
date = "2026-10-01"
pm25 = "48"
temperature = 86

# Format station name
station = station.strip().title()

# Convert readings
pm25 = float(pm25)

# Convert Fahrenheit to Celsius
celsius = (temperature - 32) * 5 / 9

print("Station:", station)
print("Date:", date)
print("PM2.5:", pm25)
print("Temperature:", round(celsius, 2), "C")

